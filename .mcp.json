{
  "mcpServers": {
    "filmcraft-mcp": {
      "command": "target/debug/filmcraft-mcp",
      "args": ["stdio"]
    },
    "filmcraft": {
      "command": "target/release/filmcraft-cli",
      "args": ["mcp", "--bridge", "127.0.0.1:9876"]
    },
    "filmcraft-headless": {
      "command": "target/release/filmcraft-cli",
      "args": ["mcp", "--demo"]
    }
  }
}
